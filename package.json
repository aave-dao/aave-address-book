{
  "name": "@aave-dao/aave-address-book",
  "version": "4.66.3",
  "description": "This repository contains an up-to-date registry of all addresses of the Aave ecosystem's smart contracts, for its usage in Solidity codebases.",
  "private": false,
  "files": [
    "dist",
    "tokenlist.json",
    "src/*.sol",
    "src/**/*.sol"
  ],
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "ui"
  ],
  "main": "./dist/AaveAddressBook.js",
  "module": "./dist/AaveAddressBook.mjs",
  "types": "./dist/AaveAddressBook.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/AaveAddressBook.d.ts",
        "default": "./dist/AaveAddressBook.js"
      },
      "import": {
        "types": "./dist/AaveAddressBook.d.mts",
        "default": "./dist/AaveAddressBook.mjs"
      }
    },
    "./abis": {
      "require": {
        "types": "./dist/abis/index.d.ts",
        "default": "./dist/abis/index.js"
      },
      "import": {
        "types": "./dist/abis/index.d.mts",
        "default": "./dist/abis/index.mjs"
      }
    },
    "./utils": {
      "require": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      },
      "import": {
        "types": "./dist/utils.d.mts",
        "default": "./dist/utils.mjs"
      }
    },
    "./tokenlist": {
      "require": {
        "types": "./dist/tokenlist.d.ts",
        "default": "./dist/tokenlist.js"
      },
      "import": {
        "types": "./dist/tokenlist.d.mts",
        "default": "./dist/tokenlist.mjs"
      }
    },
    "./*": {
      "require": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "import": {
        "types": "./dist/*.d.mts",
        "default": "./dist/*.mjs"
      }
    }
  },
  "sideEffects": false,
  "scripts": {
    "prettier": "prettier --write 'src/**/*.{sol,ts}'",
    "check:verification": "tsx scripts/verifyVerified.ts",
    "check:sanity": "tsx scripts/sanity.ts",
    "generate:abis": "tsx scripts/generateABIs.ts && prettier --write 'src/ts/abis/**/*.ts'",
    "generate:safe": "tsx scripts/generateSafeCSV.ts",
    "generate:addresses": "tsx scripts/generateAddresses.ts && npm run generate:safe && npm run prettier",
    "start": "tsx scripts/generateABIs.ts && tsx scripts/generateAddresses.ts && npm run prettier",
    "build": "tsup",
    "build:ui": "npm run build && cd ui && npm run build",
    "test": "vitest run tests",
    "prepublishOnly": "npm run build",
    "test:snapshot": "npx vitest -u"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aave-dao/aave-address-book.git"
  },
  "author": "BGD Labs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aave-dao/aave-address-book/issues"
  },
  "homepage": "https://github.com/aave-dao/aave-address-book#readme",
  "devDependencies": {
    "@aave-dao/react-web3-icons": "^1.52.2",
    "@aave-dao/toolbox": "^0.5.0",
    "@size-limit/file": "^12.0.0",
    "@types/node": "^25.2.0",
    "@uniswap/token-lists": "^1.0.0-beta.33",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.4.1",
    "esbuild-plugin-file-path-extensions": "^2.0.0",
    "lefthook": "^1.8.4",
    "prettier": "^3.5.0",
    "prettier-plugin-solidity": "^1.4.2",
    "size-limit": "^12.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "viem": "^2.46.1",
    "vitest": "^4.0.15"
  },
  "peerDependencies": {
    "viem": "^2.23.5"
  },
  "packageManager": "^npm@11.0.0",
  "overrides": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  }
}
